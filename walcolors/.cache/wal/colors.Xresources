! X colors.
! Generated by 'wal'
*foreground:        #c3c5c7
*background:        #0f1722
*.foreground:       #c3c5c7
*.background:       #0f1722
emacs*foreground:   #c3c5c7
emacs*background:   #0f1722
URxvt*foreground:   #c3c5c7
XTerm*foreground:   #c3c5c7
UXTerm*foreground:  #c3c5c7
URxvt*background:   [100]#0f1722
XTerm*background:   #0f1722
UXTerm*background:  #0f1722
URxvt*cursorColor:  #c3c5c7
XTerm*cursorColor:  #c3c5c7
UXTerm*cursorColor: #c3c5c7
URxvt*borderColor:  [100]#0f1722

! Colors 0-15.
*.color0: #0f1722
*color0:  #0f1722
*.color1: #4B5466
*color1:  #4B5466
*.color2: #5A5761
*color2:  #5A5761
*.color3: #A0081A
*color3:  #A0081A
*.color4: #B43644
*color4:  #B43644
*.color5: #976868
*color5:  #976868
*.color6: #A1769F
*color6:  #A1769F
*.color7: #c3c5c7
*color7:  #c3c5c7
*.color8: #5e6773
*color8:  #5e6773
*.color9: #4B5466
*color9:  #4B5466
*.color10: #5A5761
*color10:  #5A5761
*.color11: #A0081A
*color11:  #A0081A
*.color12: #B43644
*color12:  #B43644
*.color13: #976868
*color13:  #976868
*.color14: #A1769F
*color14:  #A1769F
*.color15: #c3c5c7
*color15:  #c3c5c7

! Black color that will not be affected by bold highlighting.
*.color66: #0f1722
*color66:  #0f1722

! Xclock colors.
XClock*foreground: #c3c5c7
XClock*background: #0f1722
XClock*majorColor:  rgba:c3/c5/c7/ff
XClock*minorColor:  rgba:c3/c5/c7/ff
XClock*hourColor:   rgba:c3/c5/c7/ff
XClock*minuteColor: rgba:c3/c5/c7/ff
XClock*secondColor: rgba:c3/c5/c7/ff

! Set depth to make transparency work.
URxvt*depth: 32
